@model IEnumerable<SistemaVendas.Models.Cidade>

@{
    ViewData["Title"] = "Cidades";
}

<div class="container mt-4">
    <div class="search-card">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="search-title">Gerenciar Cidades</h2>
            <a asp-action="Create" class="btn btn-primary">➕ Nova Cidade</a>
        </div>

        <table class="table">
            <thead>
                <tr>
                    <th>Descrição (Nome)</th>
                    <th>Sigla</th>
                    <th class="text-end">Ações</th>
                </tr>
            </thead>
            <tbody>
        @foreach (var item in Model) {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.Descricao)</td>
                    <td>@Html.DisplayFor(modelItem => item.Sigla)</td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@item.Id">Editar</a>
                        <a asp-action="Details" asp-route-id="@item.Id">Detalhes</a>
                        <a asp-action="Delete" asp-route-id="@item.Id">Excluir</a>
                    </td>
                </tr>
        }
            </tbody>
        </table>
    </div>
</div>