@model SistemaVendas.Models.Cliente

@{
    ViewData["Title"] = "Editar Cliente";
}

<div class="container mt-4">
    <div class="search-card">
        <div class="mb-4">
            <h2 class="search-title">Editar Cliente</h2>
            <p class="text-muted">Atualize os dados de contato e localização do comprador.</p>
        </div>

        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="Id" />
            
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Nome" class="control-label"></label>
                    <input asp-for="Nome" class="form-control" />
                    <span asp-validation-for="Nome" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Area" class="control-label">Área</label>
                    <input asp-for="Area" class="form-control" />
                    <span asp-validation-for="Area" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="Idade" class="control-label"></label>
                    <input asp-for="Idade" class="form-control" />
                    <span asp-validation-for="Idade" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="ValorHora" class="control-label">Valor Hora</label>
                    <input asp-for="ValorHora" class="form-control" />
                    <span asp-validation-for="ValorHora" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="CidadeId" class="control-label">Cidade</label>
                    <select asp-for="CidadeId" class="form-control" asp-items="ViewBag.CidadeId"></select>
                    <span asp-validation-for="CidadeId" class="text-danger"></span>
                </div>
            </div>

            <div class="mt-4 pt-3 border-top d-flex gap-2">
                <button type="submit" class="btn btn-primary">💾 Salvar Alterações</button>
                <a asp-action="Index" class="btn btn-light" style="border-radius: 25px; border: 1px solid #ddd;">Voltar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}