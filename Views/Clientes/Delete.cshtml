@model SistemaVendas.Models.Cliente

@{
    ViewData["Title"] = "Excluir Cliente";
}

<div class="container mt-4">
    <div class="search-card" style="border: 2px solid #ED1C24;">
        <div class="mb-4">
            <h2 class="search-title text-danger">⚠️ Confirmar Exclusão</h2>
            <p class="text-muted">Atenção: remover este cliente apagará seu registro permanentemente do banco de dados.</p>
        </div>

        <div class="row mb-4 p-3" style="background-color: #FFF0F0; border-radius: 8px;">
            <div class="col-md-6 mb-3">
                <h6 class="text-danger mb-1" style="font-size: 0.85rem; text-transform: uppercase;">Nome</h6>
                <p class="fs-5 fw-bold text-dark mb-0">@Html.DisplayFor(model => model.Nome)</p>
            </div>
            <div class="col-md-6 mb-3">
                <h6 class="text-danger mb-1" style="font-size: 0.85rem; text-transform: uppercase;">Cidade</h6>
                <p class="fs-5 fw-bold text-dark mb-0">@Html.DisplayFor(model => model.Cidade.Descricao)</p>
            </div>
        </div>

        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <div class="mt-4 pt-3 border-top d-flex gap-2">
                <button type="submit" class="btn btn-danger" style="background-color: #ED1C24; border-radius: 25px; padding: 8px 20px; font-weight: 600; color: white; border: none;">🗑️ Sim, Excluir</button>
                <a asp-action="Index" class="btn btn-light" style="border-radius: 25px; border: 1px solid #ddd;">Cancelar</a>
            </div>
        </form>
    </div>
</div>