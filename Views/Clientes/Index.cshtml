@model IEnumerable<SistemaVendas.Models.Cliente>

@{
    ViewData["Title"] = "Clientes";
}

<div class="container mt-4">
    <div class="search-card">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="search-title">Gerenciar Clientes</h2>
            <a asp-action="Create" class="btn btn-primary">➕ Novo Cliente</a>
        </div>

        <table class="table">
            <thead>
                <tr>
                    <th>Nome</th>
                    <th>Área</th>
                    <th>Idade</th>
                    <th>Cidade</th>
                    <th class="text-end">Ações</th>
                </tr>
            </thead>
            <tbody>
        @foreach (var item in Model) {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.Nome)</td>
                    <td>@Html.DisplayFor(modelItem => item.Area)</td>
                    <td>@Html.DisplayFor(modelItem => item.Idade) anos</td>
                    <td>@Html.DisplayFor(modelItem => item.Cidade.Descricao)</td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@item.Id">Editar</a>
                        <a asp-action="Details" asp-route-id="@item.Id">Detalhes</a>
                        <a asp-action="Delete" asp-route-id="@item.Id">Excluir</a>
                    </td>
                </tr>
        }
            </tbody>
        </table>
    </div>
</div>