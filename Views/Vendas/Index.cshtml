@model IEnumerable<SistemaVendas.Models.Venda>

@{
    ViewData["Title"] = "Vendas";
}

<div class="container mt-4">
    <div class="search-card">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="search-title">Gerenciar Vendas</h2>
            <a asp-action="Create" class="btn btn-primary">➕ Nova Venda</a>
        </div>

        <table class="table">
            <thead>
                <tr>
                    <th>Data</th>
                    <th>Vendedor</th>
                    <th>Cliente</th>
                    <th>Veículo</th>
                    <th>Valor de Venda</th>
                    <th class="text-end">Ações</th>
                </tr>
            </thead>
            <tbody>
        @foreach (var item in Model) {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.DataVenda)</td>
                    <td>@Html.DisplayFor(modelItem => item.Vendedor)</td>
                    <td>@Html.DisplayFor(modelItem => item.Cliente.Nome)</td>
                    <td>@Html.DisplayFor(modelItem => item.Veiculo.Modelo)</td>
                    <td class="text-success fw-bold">R$ @Html.DisplayFor(modelItem => item.ValorVenda)</td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@item.Id">Editar</a>
                        <a asp-action="Details" asp-route-id="@item.Id">Detalhes</a>
                        <a asp-action="Delete" asp-route-id="@item.Id">Excluir</a>
                    </td>
                </tr>
        }
            </tbody>
        </table>
    </div>
</div>